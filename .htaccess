<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass Authorization Header to PHP FastCGI/FPM
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # API requests route to PHP API router
  RewriteCond %{REQUEST_URI} ^/api/(.*)$
  RewriteRule ^api/(.*)$ api.php [QSA,L]

  # Existing files and directories serve directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # All other routes fallback to React index.html for SPA routing
  RewriteRule ^ index.html [L]
</IfModule>

# The HTML entry point must not be cached between deployments. Hashed JS/CSS
# assets remain cacheable, while every new build gets picked up immediately.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
</IfModule>
